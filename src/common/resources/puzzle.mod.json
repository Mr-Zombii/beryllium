{
  "formatVersion": 3,
  "display-name": "${p_name}",
  "id": "${p_id}",
  "version": "${p_version}",
  "description": "${p_desc}",
  "authors": [
    "${p_author}"
  ],
  "can-load-on": {
    "client": true,
    "server": false
  },

  "meta": {
    "icon": "${p_id}:icons/icon.png"
  },

  "entrypoints": {
    "client-init": "${p_group}.client.BerylliumClient",
    "client-postInit": "${p_group}.client.BerylliumClient",
    "init": "${p_group}.common.BerylliumCommon"
  },

  "mixins": [
    "${p_id}.common.mixins.json",
    {
      "config": "${p_id}.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "cosmic-reach": ">=0.5.20-alpha",
    "puzzle-loader-cosmic": ">=1.6.2-alpha",
    "puzzle-loader-core": ">=1.4.0-alpha"
  },

  "access-writers": [
    "${p_id}.manipulator"
  ],

  "custom": {
    "loom:injected_interfaces": {
    }
  }
}